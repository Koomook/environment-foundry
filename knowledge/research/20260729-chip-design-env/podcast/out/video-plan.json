    {
      "page_index": 47,
      "source_index": 27,
      "speaker": "진행자",
      "text": "그 회사들은 왜 데이터를 주죠?",
      "text_sha256": "70252c9f491f6426e29c66a33735e284156d4e0fffd872c9e326b51e3201c44b",
      "start_seconds": 603.47,
      "end_seconds": 606.29,
      "font_size": 132,
      "lines": [
