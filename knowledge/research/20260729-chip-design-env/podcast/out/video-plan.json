      ],
      "frame_file": "assembly/generate-frames/page-0045.png",
      "frame_sha256": "6f5c485e7c8162eb98781fc4932758471401ff612b89ab944186b1f13cc5d59c"
    },
    {
      "page_index": 46,
      "source_index": 26,
      "speaker": "연구자",
      "text": "에피소드 아이디, 행동 종류, 점수, 실행 시간, 영수증 같은 것만요. 두 번째 과녁은 IP 벤더예요. 칩스앤미디어나 퀄리타스 같은 회사는 블록 단위라 권리를 쪼개기 가장 쉽습니다.",
      "text_sha256": "e70072116c3abef6e616b26d10d44b4fb76566883b2e2d4503c1a095e218ddb2",
      "start_seconds": 588.984,
      "end_seconds": 603.47,
