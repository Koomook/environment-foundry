{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-episode-v2.schema.json",
  "title": "Environment Foundry normalized episode V2",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "source",
    "split",
    "capability_level",
    "task",
    "observation",
    "action_space",
    "transition",
    "termination",
    "grader",
    "rights",
    "raw_ref",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "environment-foundry.normalized-episode.v2"
    },
    "episode_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["name", "kind", "revision", "upstream_schema"]
    },
    "split": {"type": "string", "minLength": 1},
    "capability_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "task": {
      "type": "object",
      "required": ["family", "instruction"]
    },
    "observation": {
      "type": "object",
      "required": ["initial", "boundary", "partial_observability"]
    },
    "action_space": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "effect"]
      }
    },
    "transition": {
      "type": "object",
      "required": ["mode", "implementation", "reset", "state_restore"]
    },
    "termination": {
      "type": "object",
      "required": ["conditions"]
    },
    "grader": {
      "type": "object",
      "required": [
        "metric",
        "hidden_reference",
        "reference_visible_to_policy",
        "upstream_implementation",
        "model_judge_required"
      ]
    },
    "rights": {
      "type": "object",
      "required": ["license", "commercial_use", "training_permission"]
    },
    "raw_ref": {
      "type": "object",
      "required": ["path", "row_selector", "raw"]
    },
    "provenance": {"type": "array", "minItems": 1},
    "limitations": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
