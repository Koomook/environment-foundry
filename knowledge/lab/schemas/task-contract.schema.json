{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-contract.schema.json",
  "type": "object",
  "required": ["task_id", "observation_cutoff", "actions", "transition", "termination", "grader", "rights_receipt"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "observation_cutoff": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "transition": {"type": "string", "minLength": 1},
    "termination": {"type": "string", "minLength": 1},
    "grader": {"type": "string", "minLength": 1},
    "rights_receipt": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
